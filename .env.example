# ==============================================================================
# Multi-Vendor Marketplace - Root Environment Variables (Docker & Local)
# ==============================================================================

# Authentication & Security
JWT_SECRET=super_secret_vendor_service_jwt_key_2026
ADMIN_EMAILS=yashdeepsingh110200@gmail.com

# SMTP Settings for OTP Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Amazon S3 - File Storage (product images + KYC documents)
# ==============================================================================
# Enter the credentials of an IAM user that can PutObject/GetObject/DeleteObject
# on the bucket below. The bucket stays private; downloads use signed URLs.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional: temporary credentials (only when using AWS STS)
# AWS_SESSION_TOKEN=

# Optional: public CDN / custom domain base URL for product images
# (for example https://cdn.example.com or https://my-bucket.s3.us-east-1.amazonaws.com).
# Leave empty to serve product images through the vendor service from the private bucket.
# AWS_S3_PUBLIC_BASE_URL=

# Optional: lifetime of signed KYC download URLs, in seconds (default 900)
# AWS_S3_SIGNED_URL_TTL=900

# Optional: S3-compatible storage (MinIO, LocalStack). AWS defaults are used when empty.
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# Frontend API Gateway Target
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_VENDOR_SERVICE_URL=http://localhost:3001
VITE_CUSTOMER_SERVICE_URL=http://localhost:3002
VITE_ORDER_SERVICE_URL=http://localhost:3003

# ==============================================================================
# Razorpay Payment Gateway (order-service)
# ==============================================================================
# Use test keys (rzp_test_...) locally and live keys only in production.
# RAZORPAY_KEY_SECRET is server-side only; never prefix it with VITE_ or expose
# it to the browser. Checkout uses only the public key ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_NAME=Atelier Objects

# Optional: set the webhook secret from the Razorpay dashboard to enable
# asynchronous payment.captured / payment.failed updates. The webhook URL is
# POST /payments/razorpay/webhook (through the gateway: :8000).
# RAZORPAY_WEBHOOK_SECRET=

