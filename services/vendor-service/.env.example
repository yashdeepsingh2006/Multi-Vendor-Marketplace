PORT=3001
MONGO_URI=mongodb://localhost:27017/
OTP_SERVICE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
ADMIN_EMAILS=admin@example.com

# ==============================================================================
# Amazon S3 - File Storage (product images + KYC documents)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional: temporary credentials (only when using AWS STS)
# AWS_SESSION_TOKEN=

# Optional: public CDN / custom domain base URL for product images
# (for example https://cdn.example.com). Leave empty to serve images through
# this service from the private bucket.
# AWS_S3_PUBLIC_BASE_URL=

# Optional: lifetime of signed KYC download URLs, in seconds (default 900)
# AWS_S3_SIGNED_URL_TTL=900

# Optional: S3-compatible storage (MinIO, LocalStack)
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false
