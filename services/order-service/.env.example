PORT=3003
MONGO_URI=mongodb://localhost:27017/
JWT_SECRET=replace_with_the_shared_jwt_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Razorpay payment gateway (use rzp_test_... keys for local development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_NAME=Atelier Objects

# Optional: configure the same secret in the Razorpay dashboard webhook settings
# to enable asynchronous payment.captured / payment.failed updates.
# RAZORPAY_WEBHOOK_SECRET=
